# Production environment template for SwiftDrop (compose.prod.yaml).
#
# Copy this file to .env.prod (git-ignored) and replace every CHANGE_ME placeholder before starting:
#   cp .env.prod.example .env.prod
#
# Generate strong random secrets (at least 32 bytes) with:
#   openssl rand -base64 48
#
# Never commit .env.prod or any real credentials.

# ---------------------------------------------------------------------------
# Container images (published to GHCR by .github/workflows/docker-publish.yml)
# ---------------------------------------------------------------------------
SWIFTDROP_FRONTEND_IMAGE=ghcr.io/shensandaru/swiftdrop-frontend
SWIFTDROP_BACKEND_IMAGE=ghcr.io/shensandaru/swiftdrop-backend
# Use "latest" (main), "dev", a version tag (e.g. "1.0.0"), or a pinned commit tag ("sha-<short>")
SWIFTDROP_IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Nginx & public ports
# ---------------------------------------------------------------------------
SWIFTDROP_HTTP_PORT=80
SWIFTDROP_HTTPS_PORT=443
# Start with http.conf for public IP testing; switch to ./deploy/nginx/https.conf after Certbot.
SWIFTDROP_NGINX_CONF=./deploy/nginx/http.conf

# ---------------------------------------------------------------------------
# Public origin & CORS (REQUIRED — update to https://your-domain once TLS is enabled)
# ---------------------------------------------------------------------------
SWIFTDROP_FRONTEND_BASE_URL=http://CHANGE_ME_VM_PUBLIC_IP
SWIFTDROP_CORS_ALLOWED_ORIGINS=http://CHANGE_ME_VM_PUBLIC_IP

# ---------------------------------------------------------------------------
# PostgreSQL 18 (REQUIRED — applied only when the postgres-data volume is first created)
# ---------------------------------------------------------------------------
SWIFTDROP_POSTGRES_DB=swiftdrop
SWIFTDROP_POSTGRES_USER=swiftdrop
SWIFTDROP_POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# ---------------------------------------------------------------------------
# RabbitMQ 4.3 (REQUIRED — applied only when the rabbitmq-data volume is first created)
# ---------------------------------------------------------------------------
SWIFTDROP_RABBITMQ_USER=swiftdrop
SWIFTDROP_RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD

# ---------------------------------------------------------------------------
# Application cryptographic secrets (REQUIRED — at least 32 bytes each)
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
SWIFTDROP_JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_BYTES_JWT_SECRET
SWIFTDROP_JWT_ISSUER=swiftdrop
SWIFTDROP_JWT_ACCESS_TOKEN_TTL=PT1H
SWIFTDROP_WEBHOOK_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_BYTES_WEBHOOK_KEY

# ---------------------------------------------------------------------------
# Bootstrap Admin account (recommended on first boot; leave blank after created)
# ---------------------------------------------------------------------------
SWIFTDROP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SWIFTDROP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ---------------------------------------------------------------------------
# Optional integrations (leave empty to keep disabled / mocked)
# ---------------------------------------------------------------------------
# Google OAuth2 (register https://<your-domain>/login/oauth2/code/google in Google Cloud Console)
SWIFTDROP_GOOGLE_CLIENT_ID=
SWIFTDROP_GOOGLE_CLIENT_SECRET=
# Frontend build-time flag (only used when building frontend locally; GHCR images pass via CI)
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# Gemini AI assistant
SWIFTDROP_GEMINI_API_KEY=
SWIFTDROP_ASSISTANT_MODEL=gemini-3.5-flash-lite

# Email notifications (mock | resend)
SWIFTDROP_NOTIFICATION_EMAIL_PROVIDER=mock
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Push notifications (mock | fcm; mount service account JSON read-only into backend if using fcm)
SWIFTDROP_NOTIFICATION_PUSH_PROVIDER=mock
SWIFTDROP_FIREBASE_SERVICE_ACCOUNT_PATH=

# ---------------------------------------------------------------------------
# Operational settings
# ---------------------------------------------------------------------------
SWIFTDROP_BUSINESS_TIME_ZONE=Asia/Colombo
SWIFTDROP_MAX_DELIVERY_ATTEMPTS=3
SWIFTDROP_TRACKING_RATE_LIMIT_PER_MINUTE=60
SWIFTDROP_DISPATCH_STALE_AFTER_HOURS=24
SWIFTDROP_SWAGGER_ENABLED=false

# ---------------------------------------------------------------------------
# Resource tuning (DEFAULT: GCP e2-micro — 1 GB RAM + 2 GB swap)
# ---------------------------------------------------------------------------
SWIFTDROP_JAVA_TOOL_OPTIONS=-Xms128m -Xmx288m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
SWIFTDROP_NODE_OPTIONS=--max-old-space-size=192
SWIFTDROP_BACKEND_MEM_LIMIT=512m
SWIFTDROP_BACKEND_MEMSWAP_LIMIT=1024m
SWIFTDROP_FRONTEND_MEM_LIMIT=256m
SWIFTDROP_FRONTEND_MEMSWAP_LIMIT=512m
SWIFTDROP_POSTGRES_MEM_LIMIT=256m
SWIFTDROP_POSTGRES_MEMSWAP_LIMIT=512m
SWIFTDROP_POSTGRES_SHARED_BUFFERS=64MB
SWIFTDROP_POSTGRES_WORK_MEM=2MB
SWIFTDROP_POSTGRES_MAINTENANCE_WORK_MEM=32MB
SWIFTDROP_POSTGRES_MAX_CONNECTIONS=40
SWIFTDROP_RABBITMQ_MEM_LIMIT=384m
SWIFTDROP_RABBITMQ_MEMSWAP_LIMIT=768m
SWIFTDROP_NGINX_MEM_LIMIT=64m
SWIFTDROP_NGINX_MEMSWAP_LIMIT=128m

# ---------------------------------------------------------------------------
# Alternative profiles (uncomment and replace the block above on larger VMs)
# ---------------------------------------------------------------------------
# --- 4 GB RAM VM (e.g., e2-medium / Azure B2s) ---
# SWIFTDROP_JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -XX:+ExitOnOutOfMemoryError
# SWIFTDROP_NODE_OPTIONS=--max-old-space-size=384
# SWIFTDROP_BACKEND_MEM_LIMIT=1024m
# SWIFTDROP_BACKEND_MEMSWAP_LIMIT=1536m
# SWIFTDROP_FRONTEND_MEM_LIMIT=512m
# SWIFTDROP_FRONTEND_MEMSWAP_LIMIT=768m
# SWIFTDROP_POSTGRES_MEM_LIMIT=768m
# SWIFTDROP_POSTGRES_MEMSWAP_LIMIT=1024m
# SWIFTDROP_POSTGRES_SHARED_BUFFERS=256MB
# SWIFTDROP_POSTGRES_WORK_MEM=4MB
# SWIFTDROP_POSTGRES_MAINTENANCE_WORK_MEM=64MB
# SWIFTDROP_POSTGRES_MAX_CONNECTIONS=80
# SWIFTDROP_RABBITMQ_MEM_LIMIT=512m
# SWIFTDROP_RABBITMQ_MEMSWAP_LIMIT=768m
# SWIFTDROP_NGINX_MEM_LIMIT=128m
# SWIFTDROP_NGINX_MEMSWAP_LIMIT=256m
#
# --- 8 GB RAM VM (e.g., e2-standard-2 / Azure B2ms) ---
# SWIFTDROP_JAVA_TOOL_OPTIONS=-Xms512m -Xmx1024m -XX:+ExitOnOutOfMemoryError
# SWIFTDROP_NODE_OPTIONS=--max-old-space-size=512
# SWIFTDROP_BACKEND_MEM_LIMIT=1536m
# SWIFTDROP_BACKEND_MEMSWAP_LIMIT=2048m
# SWIFTDROP_FRONTEND_MEM_LIMIT=512m
# SWIFTDROP_FRONTEND_MEMSWAP_LIMIT=1024m
# SWIFTDROP_POSTGRES_MEM_LIMIT=1536m
# SWIFTDROP_POSTGRES_MEMSWAP_LIMIT=2048m
# SWIFTDROP_POSTGRES_SHARED_BUFFERS=512MB
# SWIFTDROP_POSTGRES_WORK_MEM=8MB
# SWIFTDROP_POSTGRES_MAINTENANCE_WORK_MEM=128MB
# SWIFTDROP_POSTGRES_MAX_CONNECTIONS=100
# SWIFTDROP_RABBITMQ_MEM_LIMIT=768m
# SWIFTDROP_RABBITMQ_MEMSWAP_LIMIT=1024m
# SWIFTDROP_NGINX_MEM_LIMIT=128m
# SWIFTDROP_NGINX_MEMSWAP_LIMIT=256m
