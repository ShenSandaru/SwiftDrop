# Local development settings, shared by Docker Compose (compose.yaml) and the backend.
#
# Create your own git-ignored copy and change the passwords:
#   PowerShell:  Copy-Item .env.example .env
#   Unix shell:  cp .env.example .env
#
# These are local-only development values, not production credentials. Never commit .env.
# Format: KEY=value, one per line, no quotes and no spaces around "=". Both Docker Compose and
# Spring Boot read this file, and they treat quotes differently.
#
# The database name, user and passwords are applied only when the Docker volumes are first
# created. Changing them later requires an intentional reset (see docs/development-setup.md).

# PostgreSQL
SWIFTDROP_POSTGRES_DB=swiftdrop
SWIFTDROP_POSTGRES_USER=swiftdrop
SWIFTDROP_POSTGRES_PASSWORD=change-me-local-postgres
# Host port. Change it (e.g. to 5433) if another PostgreSQL already uses 5432.
SWIFTDROP_POSTGRES_PORT=5432

# RabbitMQ
SWIFTDROP_RABBITMQ_USER=swiftdrop
SWIFTDROP_RABBITMQ_PASSWORD=change-me-local-rabbitmq
SWIFTDROP_RABBITMQ_PORT=5672
SWIFTDROP_RABBITMQ_MANAGEMENT_PORT=15672
# Outbox relay that publishes parcel status events to RabbitMQ (delivery module, ADR 0004).
# On by default; set to false to stop publishing (events then wait in the outbox).
# SWIFTDROP_OUTBOX_RELAY_ENABLED=true

# Backend access tokens (JWT, HS256). Required: the backend refuses to start without a secret of at
# least 32 bytes. Generate your own, e.g. PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# or Unix: openssl rand -base64 48
SWIFTDROP_JWT_SECRET=
# Optional, with these defaults: issuer, token lifetime (ISO-8601), allowed browser origins.
# SWIFTDROP_JWT_ISSUER=swiftdrop
# SWIFTDROP_JWT_ACCESS_TOKEN_TTL=PT15M
# SWIFTDROP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google sign-in (optional). Leave the client ID empty to disable Google login; local login still
# works. To enable it, create an OAuth client of type "Web application" in the Google Cloud console
# with the redirect URI http://localhost:8080/login/oauth2/code/google, and put your own values
# here (never commit them). The secret is required once a client ID is set.
SWIFTDROP_GOOGLE_CLIENT_ID=
SWIFTDROP_GOOGLE_CLIENT_SECRET=

# Bootstrap Dispatcher/Admin account (optional). When both variables are set and no admin
# account exists in the database, the backend creates one on startup. If only one is set,
# startup fails.
SWIFTDROP_BOOTSTRAP_ADMIN_EMAIL=
SWIFTDROP_BOOTSTRAP_ADMIN_PASSWORD=

# Delivery (optional). Time zone that decides which deliveries count as "today" for couriers.
# SWIFTDROP_BUSINESS_TIME_ZONE=Asia/Colombo
# Delivery attempts before a parcel goes back to the sender (ADR 0009), 1 to 5.
# SWIFTDROP_MAX_DELIVERY_ATTEMPTS=3

# AI assistant (optional, ADR 0010). Get a free Gemini API key at https://aistudio.google.com and
# put it here, never in Git. Without a key the assistant answers that it is unavailable. The model
# name is optional; check which models the free tier offers at https://ai.google.dev.
SWIFTDROP_GEMINI_API_KEY=
# SWIFTDROP_ASSISTANT_MODEL=gemini-2.5-flash
