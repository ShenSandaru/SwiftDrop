# TEMPLATE ONLY — ONLY NEEDED IF GHCR PACKAGES ARE PRIVATE.
#
# If ghcr.io/shensandaru/swiftdrop-frontend and swiftdrop-backend are Public, you do not need
# this secret. If they are Private, create it with kubectl (never commit a real token):
#
#   kubectl -n swiftdrop create secret docker-registry ghcr-pull-secret \
#     --docker-server=ghcr.io \
#     --docker-username=ShenSandaru \
#     --docker-password="$GHCR_READ_TOKEN"
#
# Then uncomment `imagePullSecrets` in backend-deployment.yaml and frontend-deployment.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull-secret
  namespace: swiftdrop
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: Q0hBTkdFX01FX0JBU0U2NF9ET0NLRVJfQ09ORklH
