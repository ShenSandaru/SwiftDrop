# TEMPLATE ONLY — NEVER COMMIT REAL SECRETS.
#
# Copy to swiftdrop-k8s/secrets/swiftdrop-secrets.yaml (git-ignored) and replace every
# CHANGE_ME placeholder, or create directly with `kubectl create secret generic`
# (see docs/kubernetes-deployment.md).
#
# Generate strong 48-byte secrets with:
#   openssl rand -base64 48
apiVersion: v1
kind: Secret
metadata:
  name: swiftdrop-secrets
  namespace: swiftdrop
  labels:
    app.kubernetes.io/part-of: swiftdrop
type: Opaque
stringData:
  # Required database & broker credentials (applied only on first volume initialization)
  SWIFTDROP_POSTGRES_PASSWORD: "CHANGE_ME_STRONG_POSTGRES_PASSWORD"
  SWIFTDROP_RABBITMQ_PASSWORD: "CHANGE_ME_STRONG_RABBITMQ_PASSWORD"

  # Required application cryptographic keys (minimum 32 bytes each)
  SWIFTDROP_JWT_SECRET: "CHANGE_ME_GENERATE_AT_LEAST_32_BYTES_JWT_SECRET"
  SWIFTDROP_WEBHOOK_SECRET_KEY: "CHANGE_ME_GENERATE_AT_LEAST_32_BYTES_WEBHOOK_KEY"

  # Recommended initial admin bootstrap account (leave empty after first boot if desired)
  SWIFTDROP_BOOTSTRAP_ADMIN_EMAIL: "admin@example.com"
  SWIFTDROP_BOOTSTRAP_ADMIN_PASSWORD: "CHANGE_ME_STRONG_ADMIN_PASSWORD"

  # Optional external integrations (leave empty to keep disabled)
  SWIFTDROP_GOOGLE_CLIENT_ID: ""
  SWIFTDROP_GOOGLE_CLIENT_SECRET: ""
  SWIFTDROP_GEMINI_API_KEY: ""
  RESEND_API_KEY: ""
